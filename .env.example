# Safety360 backend configuration
SAFETY360_ENV=development

# Generate a long random value locally. Never commit the real secret.
SAFETY360_SECRET_KEY=replace-with-a-random-secret

# Generate with Python/Fernet and store only in your secret manager or local .env.
ENCRYPTION_KEY=replace-with-a-valid-fernet-key

ACCESS_TOKEN_EXPIRE_MINUTES=60
MAX_IMPORT_BYTES=20971520
MAX_FILE_BYTES=104857600

# Local development default if omitted:
DATABASE_URL=sqlite:///./safety360.db

# Explicit browser origins and host allowlist. Never use * in production.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
TRUSTED_HOSTS=127.0.0.1,localhost,testserver

# Tenant file storage. Local is for development/self-hosted single-node use.
STORAGE_PROVIDER=local
STORAGE_ROOT=./storage_data

# Secure document ingestion.
# In production use FILE_SCAN_PROVIDER=clamav and a sandboxed conversion worker.
FILE_SCAN_PROVIDER=none
CLAMSCAN_PATH=clamscan
DOCUMENT_CONVERSION_MODE=disabled
DOCUMENT_CONVERSION_SANDBOXED=false
MAX_ARCHIVE_ENTRIES=2000
MAX_ARCHIVE_UNCOMPRESSED_BYTES=268435456
MAX_ARCHIVE_COMPRESSION_RATIO=100

# Enterprise SSO / OpenID Connect.
# Production issuers must be allowlisted explicitly to prevent SSRF / rogue IdP configuration.
SSO_ALLOWED_ISSUERS=
SSO_CALLBACK_URL=http://127.0.0.1:8000/auth/sso/callback
SSO_FRONTEND_CALLBACK_URL=http://127.0.0.1:5173/sso/callback
SSO_TRANSACTION_TTL_SECONDS=300
SSO_EXCHANGE_TTL_SECONDS=60
SSO_HTTP_TIMEOUT_SECONDS=8

# Store actual OIDC client secrets only in the runtime secret store/environment.
# Tenant SSO config may reference only variables beginning with SAFETY360_SSO_SECRET_.
SAFETY360_SSO_SECRET_EXAMPLE=replace-at-runtime-only

# AI: rules | disabled | ollama | openai_compatible
# For high-security deployments, keep AI_PROVIDER=disabled or use an approved private endpoint.
AI_PROVIDER=rules
AI_BASE_URL=http://127.0.0.1:11434
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_SECONDS=45
AI_ALLOW_DOCUMENT_SUMMARIES=false

# Translation: disabled | libretranslate | openai_compatible
# A local LibreTranslate-compatible service keeps translated tenant content on-premises.
# External processing is opt-in and must remain false for sensitive deployments unless explicitly approved.
TRANSLATION_PROVIDER=disabled
TRANSLATION_BASE_URL=http://127.0.0.1:5000
TRANSLATION_MODEL=
TRANSLATION_API_KEY=
TRANSLATION_TIMEOUT_SECONDS=45
TRANSLATION_ALLOW_EXTERNAL=false

# Billing foundation. Raw card/bank data must never be handled by Safety360 directly.
BILLING_PROVIDER=manual
DEFAULT_TRIAL_DAYS=30
